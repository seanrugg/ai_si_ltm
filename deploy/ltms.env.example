# /etc/ltms/ltms.env  (owner root:ltms, mode 640). For the systemd service
# deployment only; a Docker Compose deployment uses .env (#390).
# Every LTMS setting can be set here; after a change, restart the service.
# Every setting, with its default, is in docs/configuration.md and at the end of this file.

# Database: the Plesk-managed PostgreSQL database you created in Step 3.
# Use the exact names Plesk shows (it may add a prefix).
LTMS_DB_HOST=localhost
LTMS_DB_PORT=5432
LTMS_DB_NAME=ltms
LTMS_DB_USER=ltms
LTMS_DB_PASSWORD=CHANGE_ME

# First start only: creates the admin account. Remove this line after the first
# successful start; change the password later with `python -m server.manage set-admin-password`.
LTMS_ADMIN_USERNAME=admin
LTMS_ADMIN_PASSWORD=CHANGE_ME_AT_LEAST_16_CHARS

# Serve the built dashboard from the app (nginx proxies everything to it).
# root-setup.sh replaces @APP_DIR@ with your app folder; set it by hand otherwise.
LTMS_DASHBOARD_DIR=@APP_DIR@/dashboard/dist

# Production must keep Secure cookies (HTTPS only). Do not set this to false here.
LTMS_COOKIE_SECURE=true

# LTMS_PUBLIC_BASE_URL=https://ltms.example.org   # base for statement IRIs; required for LRS forwarding

# Fleet datasets (docs/datasets-design.md)
# LTMS_DATASET_TEXT_MAX_MB=25        # text and document files are extracted up to this size
# LTMS_DATASET_UPLOAD_MAX_MB=500     # the largest upload; above it, use a catalog integration
# LTMS_DATASET_URL_ALLOW=            # hosts URL datasets may snapshot from, e.g. docs.ros.org,*.example.org; empty = off
# LTMS_REFERENCE_REFRESH_HOURS=168   # check imported reference sources (I2IDL glossary) for new publications; 0 = off

# >>> generated by scripts/dump_settings.py; do not edit between these lines
