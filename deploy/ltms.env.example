# /etc/ltms/ltms.env  (owner root:ltms, mode 640)
# Every setting in config/default.yaml can be overridden here as LTMS_<KEY>.

# Database: the Plesk-managed PostgreSQL database you created in Step 3.
# Use the exact names Plesk shows (it may add a prefix).
LTMS_DB_HOST=localhost
LTMS_DB_PORT=5432
LTMS_DB_NAME=ltms
LTMS_DB_USER=ltms
LTMS_DB_PASSWORD=CHANGE_ME

# First start only: creates the admin account. Remove this line after the first
# successful start; change the password later with `python -m server.manage set-admin-password`.
LTMS_ADMIN_USERNAME=admin
LTMS_ADMIN_PASSWORD=CHANGE_ME_AT_LEAST_16_CHARS

# Serve the built dashboard from the app (nginx proxies everything to it).
# root-setup.sh replaces @APP_DIR@ with your app folder; set it by hand otherwise.
LTMS_DASHBOARD_DIR=@APP_DIR@/dashboard/dist

# Production must keep Secure cookies (HTTPS only). Do not set this to false here.
LTMS_COOKIE_SECURE=true
