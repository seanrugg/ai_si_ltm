# Settings for a Claude Code member mind (#341). Copy to mind.env beside the key,
# for example /Users/YOU/.ltms/mind-claude/mind.env, and fill in. See docs/mind.md.
LTMS_SERVER=https://ltms.example.org
# The member's own key (mode 600). Never in the repo, the prompt or the logs.
LTMS_KEY_PATH=/Users/YOU/.ltms/mind-claude/<member>.key.json
MIND_BRAIN=claude-code
MIND_MODEL_FAMILY=claude
# Full path to claude: launchd's PATH won't find it (run `command -v claude`).
MIND_CLAUDE_BIN=/opt/homebrew/bin/claude
# Optional: a model or alias; empty = Claude Code's default.
MIND_CLAUDE_MODEL=
MIND_CLAUDE_TIMEOUT=3m
# Optional: a dollar cap per call (only for API-key billing).
MIND_CLAUDE_MAX_USD=
# Deep tasks (verify, reflect, study) at night, plus one in the day.
MIND_DREAM=window 01:00-05:00
MIND_DAY_DREAMS=1
# Per wake. A headless call carries Claude Code's own system prompt, so start here
# and tune from the budget in the first cycle events.
MIND_BRAIN_CALLS=6
MIND_TOKENS=150000
MIND_SECONDS=15m
MIND_DAILY_WRITES=20
