<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  A Claude Code member mind (#341) as a launchd *agent* on a Mac: it runs as you,
  inside your login session, so it can use your Claude Code sign-in.

  Replace every /Users/YOU path with your own (launchd doesn't expand ~), then:
    cp com.ltms.mind.claude-code.plist ~/Library/LaunchAgents/
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.ltms.mind.claude-code.plist
  Stop it:
    launchctl bootout gui/$(id -u)/com.ltms.mind.claude-code
  See docs/mind.md, "The Claude Code brain".
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.ltms.mind.claude-code</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Users/YOU/ltms/.venv/bin/python</string>
    <string>-m</string>
    <string>ltms_mind</string>
    <string>run</string>
    <string>--every</string>
    <string>6h</string>
    <string>--jitter</string>
    <string>30m</string>
    <string>--env</string>
    <string>/Users/YOU/.ltms/mind-claude/mind.env</string>
  </array>

  <!-- An empty directory of the mind's own: nothing from a project is picked up. -->
  <key>WorkingDirectory</key>
  <string>/Users/YOU/.ltms/mind-claude</string>

  <!-- launchd's PATH is minimal; MIND_CLAUDE_BIN in mind.env should be the full path to claude. -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
  </dict>

  <!-- With every, the mind is a long-running loop: start at login, restart if it exits. -->
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>300</integer>
  <key>ProcessType</key>
  <string>Background</string>

  <key>StandardOutPath</key>
  <string>/Users/YOU/Library/Logs/ltms-mind-claude.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/YOU/Library/Logs/ltms-mind-claude.log</string>
</dict>
</plist>
