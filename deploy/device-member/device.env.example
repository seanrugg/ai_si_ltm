# ~/.ltms/device/device.env   (mode 0600; the directory 0700)
# A device member with a mind (#521), e.g. the Mac Studio: `python -m ltms_mind.member`.
# The device is the member. Harnesses on it (Hermes, coding agents) record through the
# handoff below; they never hold this key. See docs/mind.md, "A device member".

# --- the member (cli_agent/member_main.py) ---
LTMS_SERVER=https://ltms.example.org
LTMS_KEY_PATH=/Users/YOU/.ltms/device/<member>.key.json
# Straight to LTMS over HTTPS. Use auto (with MQTT_HOST etc.) once the device has an
# account on a hub's broker.
TRANSPORT=direct
MEMBER_OUTBOX_PATH=/Users/YOU/.ltms/device/member-outbox.db
MEMBER_STATE_PATH=/Users/YOU/.ltms/device/member-head.json
HEARTBEAT_SECONDS=43200

# The handoff: harnesses on this device submit records here; this process signs them.
# Whoever can write this file records as the device: keep it in this 0700 directory.
MEMBER_HANDOFF_PATH=/Users/YOU/.ltms/device/handoff.db

# --- the mind (ltms_mind; docs/mind.md) ---
MEMBER_MIND_SECONDS=30m
MIND_BRAIN=local
MIND_LOCAL_URL=http://127.0.0.1:11434/v1
MIND_LOCAL_MODEL=gemma4:31b
# MIND_MODEL_FAMILY          from the model name (gemma4:31b -> gemma); set it if it isn't recognised
# MIND_DREAM=always          when the deep tasks run: never | always | window 01:00-05:00 | idle 30
MIND_DREAM=always
# MIND_LOCAL_TIMEOUT=2m      a 31B model can take a while per task
MIND_LOCAL_TIMEOUT=5m
MIND_LOCAL_MAX_TOKENS=2048
# MIND_SECONDS=300           the time budget for ONE wake (not how often: that's MEMBER_MIND_SECONDS)
MIND_SECONDS=900
# MIND_DAILY_WRITES=20
