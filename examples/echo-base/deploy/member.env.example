# /etc/echo-base/member.env  (owner echobase:echobase, mode 0600)
# Every variable load_config reads in cli_agent/member_main.py; defaults shown as comments.

# Required: the member's Ed25519 key file (its name is the member name).
LTMS_KEY_PATH=/etc/echo-base/pi-zero.key

# The swarm's MQTT topic ID (#293), e.g. sw-1a2b3c4d. If unset and LTMS_SERVER is set,
# it is looked up from LTMS at start (the member must already be in a swarm).
SWARM_TOPIC_ID=<swarm-topic-id>

# LTMS_SERVER              (optional) to look the topic ID up, and for the direct fallback.
# TRANSPORT                (default auto) mqtt | direct | auto (#297). auto: MQTT through the hub;
#                          if the broker is unreachable for FALLBACK_AFTER_SECONDS (default 120),
#                          send straight to LTMS over HTTPS until it's back. Needs LTMS_SERVER.
# SWARM                    (deprecated) the swarm's name as the topic prefix; kept as is,
#                          with a warning naming the topic ID to move to.

# MEMBER_OUTBOX_PATH       (default "member-outbox.db")
MEMBER_OUTBOX_PATH=/var/lib/echo-base/member-outbox.db

# MEMBER_STATE_PATH        (default "member-head.json")
MEMBER_STATE_PATH=/var/lib/echo-base/member-head.json

# MQTT_HOST                (default "localhost")
MQTT_HOST=hub.local   # hostname or IP of the machine running Mosquitto and the hub

# MQTT_PORT                (default 1883)
MQTT_PORT=1883

# MQTT_USERNAME            (default None)
MQTT_USERNAME=pi-zero

# MQTT_PASSWORD            (default None)
MQTT_PASSWORD=change-me

# HEARTBEAT_SECONDS        (default 43200, twice daily; must be > 0). Keep it long: an admin can
# ping the member from the dashboard when troubleshooting (#356).
HEARTBEAT_SECONDS=43200
# RESEND_SECONDS           (default 60) resend unacked records this often
# PING_POLL_SECONDS        (default 30) with LTMS_SERVER set, check LTMS for admin pings
