# /etc/echo-base/hub.env  (owner echobase:echobase, mode 0600)
# Every variable load_config reads in cli_agent/hub_main.py; defaults shown as comments.

# Required: where the LTMS server lives.
LTMS_SERVER=http://ltms.example.com

# Required: the hub's Ed25519 key file (its name is the member name).
LTMS_KEY_PATH=/etc/echo-base/jetson-hub.key

# The swarm's MQTT topic ID (#293), e.g. sw-1a2b3c4d. If unset, the hub looks it up from
# LTMS at start (GET /api/swarm) and logs it. Renaming the swarm never changes it.
SWARM_TOPIC_ID=<swarm-topic-id>

# SWARM                    (deprecated) the swarm's name as the topic prefix.
# SWARM_LEGACY_NAME        (migration) also serve <name>/+/... while members move to the topic ID.

# HUB_OUTBOX_PATH          (default "hub-outbox.db")
HUB_OUTBOX_PATH=/var/lib/echo-base/hub-outbox.db

# MQTT_HOST                (default "localhost")
MQTT_HOST=localhost

# MQTT_PORT                (default 1883)
MQTT_PORT=1883

# MQTT_USERNAME            (default None)
MQTT_USERNAME=jetson-hub

# MQTT_PASSWORD            (default None)
MQTT_PASSWORD=change-me

# TICK_SECONDS             (default 10.0; must be > 0)
TICK_SECONDS=10.0

# HUB_HEARTBEAT_SECONDS    (default 300; must be > 0). The hub signs its own heartbeat
# on start and then at this interval, so a running hub shows as seen in LTMS (#281).
HUB_HEARTBEAT_SECONDS=300

# HUB_STATE_PATH           (default: hub-head.json in the outbox's directory)
# The hub's own chain head, so its sequence continues after a restart.

# HUB_MAX_MSGS_PER_SECOND  (default 10; whole number > 0). Swarm messages forwarded per
# member per second (#300); extras are dropped and counted in the hub's heartbeat.

# Machine health (#349). Read-only; needs no root.
# HUB_HEALTH               auto (default: on for a Jetson) | 1 | 0
# HUB_HEALTH_SECONDS       (default 300) one signed health self-report per window (min/max/last)
# HUB_HEALTH_SAMPLE_SECONDS (default 30) how often the machine is read
# HUB_HEALTH_SERVICES      name=http(s)://url or name=systemd:unit, comma-separated
HUB_HEALTH_SERVICES=ollama=http://127.0.0.1:11434/api/tags,wire-pod=systemd:wire-pod
# HUB_HEALTH_STATE         (default: hub-health.json beside the outbox) newest reading, world-readable,
#                          for `python -m cli_agent.hub_health latest --speak`
HUB_HEALTH_STATE=/var/lib/echo-base/hub-health.json
