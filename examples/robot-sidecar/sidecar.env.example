# Robot sidecar (#312). Member settings are the same as cli_agent.member_main's.
LTMS_SERVER=https://ltms.example.org
LTMS_KEY_PATH=/etc/robot-sidecar/robot.key
MEMBER_OUTBOX_PATH=/var/lib/robot-sidecar/outbox.db
MEMBER_STATE_PATH=/var/lib/robot-sidecar/head.json
TRANSPORT=auto
MQTT_HOST=hub.local
MQTT_PORT=1883
MQTT_USERNAME=robot
MQTT_PASSWORD=change-me

SIDECAR_ADAPTERS=wirepod,vector_sdk
BODY_SECONDS=30
# Where the robot's AI runs (the bridge), for the cognition report: name@where, comma-separated (≤ 4).
SIDECAR_COGNITION_MODELS=

# wirepod adapter
WIREPOD_URL=http://127.0.0.1:8080
WIREPOD_ESN=
WIREPOD_POLL_SECONDS=2
# Optional: a custom intent whose spoken text comes from the hub's health reading (#349).
SIDECAR_STATUS_REPORT_INTENT=
SIDECAR_HEALTH_STATE=

# vector_sdk adapter
VECTOR_SERIAL=
VECTOR_BODY_SECONDS=1
VECTOR_FACE_GAP_SECONDS=10
VECTOR_BATTERY_SECONDS=30
