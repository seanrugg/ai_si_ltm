# Robot sidecar (#312). Member settings are the same as cli_agent.member_main's.
LTMS_SERVER=https://ltms.example.org
LTMS_KEY_PATH=/etc/robot-sidecar/robot.key
MEMBER_OUTBOX_PATH=/var/lib/robot-sidecar/outbox.db
MEMBER_STATE_PATH=/var/lib/robot-sidecar/head.json
TRANSPORT=auto
MQTT_HOST=hub.local
MQTT_PORT=1883
MQTT_USERNAME=robot
MQTT_PASSWORD=change-me

SIDECAR_ADAPTERS=wirepod,vector_sdk
BODY_SECONDS=30
# The models the robot's AI uses, and where they run: name@where, comma-separated (≤ 4).
# Used for the cognition report and, first entry, for each LLM reply's model and runs_on.
# Left empty, the sidecar logs a warning and the profile shows "Language models: not reported".
# Vector with wire-pod answering through an Ollama model on the hub:
#   SIDECAR_COGNITION_MODELS=<ollama model>@<hub host>
SIDECAR_COGNITION_MODELS=

# wirepod adapter
WIREPOD_URL=http://127.0.0.1:8080
WIREPOD_ESN=
WIREPOD_POLL_SECONDS=2
# Optional: a custom intent whose spoken text comes from the hub's health reading (#349).
SIDECAR_STATUS_REPORT_INTENT=
SIDECAR_HEALTH_STATE=

# vector_sdk adapter
VECTOR_SERIAL=
VECTOR_BODY_SECONDS=1
# How often status flags are read, and how long a change must last to be an episode.
VECTOR_FLAG_SECONDS=0.1
VECTOR_DEBOUNCE_SECONDS=0.5
VECTOR_FACE_GAP_SECONDS=10
VECTOR_BATTERY_SECONDS=30
# Reconnect when IMU, touch raw and proximity signal_quality stay bit-identical
# this long: the SDK stream froze (#486). 0 turns the check off.
VECTOR_STALE_SECONDS=10
# Longest wait between reconnects while the stream stays frozen (#498).
VECTOR_STALE_RETRY_MAX_SECONDS=30
# Energy reflex (#513): send Vector to his charger after this long off the dock
# (or at battery level 1). The sidecar's only command. 0 turns it off.
VECTOR_HOME_AFTER_MINUTES=45

# The robot's mind (#519): off unless SIDECAR_MIND_SECONDS is set (e.g. 1h).
# It runs inside this process, on the robot's own key. It dreams while the robot
# rests (Vector: on the charger), thinking with MIND_BRAIN; awake it does duties only
# (no model). It never drives the robot. See docs/mind.md.
# SIDECAR_MIND_SECONDS=1h
# MIND_BRAIN=local
# The model the robot's voice bridge already uses (wire-pod: Settings > Knowledge Graph):
# MIND_LOCAL_URL=http://127.0.0.1:11434/v1
# MIND_LOCAL_MODEL=<the same model name>
# MIND_MODEL_FAMILY=<qwen, llama, ...>   lets members of other families review its lessons
